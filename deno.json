    "elm": "npm:elm@0.19.2-0",
    "elm-format": "npm:elm-format@0.8.8",
    "elm-test": "npm:elm-test@0.19.2-1",
    "tailwindcss": "npm:tailwindcss@4.3.3",
    "vite": "npm:vite@8.2.2",
    "vite-plugin-elm": "npm:vite-plugin-elm@3.0.1"
  }
}
